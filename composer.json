{
  "name": "captchano/captchano",
  "description": "Official CaptchaNo PHP SDK — solve reCAPTCHA v2/v3/Enterprise, Cloudflare Turnstile, DataDome and image captchas through the CaptchaNo API. PHP 8.1+, typed, works with Laravel, Symfony and plain PHP.",
  "type": "library",
  "license": "MIT",
  "keywords": ["captchano", "captcha", "captcha solver", "recaptcha", "recaptcha v2", "recaptcha v3", "turnstile", "cloudflare turnstile", "datadome", "image captcha", "captcha api", "web scraping", "symfony panther", "guzzle", "psr-18", "sdk"],
  "homepage": "https://captchano.com/captcha-solver-api",
  "authors": [{ "name": "DishIs Technologies LLC", "email": "support@captchano.com", "homepage": "https://captchano.com" }],
  "support": {
    "issues": "https://github.com/DishantSinghDev2/captchano-php/issues",
    "source": "https://github.com/DishantSinghDev2/captchano-php",
    "docs": "https://captchano.com/captcha-solver-api",
    "email": "support@captchano.com"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "psr/http-client": "^1.0"
  },
  "suggest": {
    "psr/http-client": "Send requests through any PSR-18 client with CaptchaNo\\Http\\Psr18Transport",
    "psr/http-factory": "Required together with psr/http-client for Psr18Transport"
  },
  "autoload": { "psr-4": { "CaptchaNo\\": "src/" } },
  "autoload-dev": { "psr-4": { "CaptchaNo\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "sort-packages": true },
  "minimum-stability": "stable"
}
